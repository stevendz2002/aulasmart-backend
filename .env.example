# Copiar como .env y reemplazar el valor local. .env está excluido de Git.
POSTGRES_PASSWORD=cambia-esta-clave-local
POSTGRES_PORT=5433
# La misma clave, la consume el backend Spring Boot vía spring.config.import
DB_PASSWORD=cambia-esta-clave-local

# Solo para desarrollo local con cuentas sintéticas. Mantener false en despliegues reales.
AULASMART_ALLOW_TEST_ACCOUNTS=false

# local: HTTP localhost; prod: HTTPS obligatorio, clave persistente y origen explícito.
SPRING_PROFILES_ACTIVE=local
# Base64 de al menos 32 bytes aleatorios. Vacío SOLO en local: clave efímera al reiniciar.
AULASMART_JWT_SECRET=
AULASMART_JWT_ISSUER=aulasmart
AULASMART_ACCESS_TTL=PT15M
AULASMART_REFRESH_TTL=P7D
AULASMART_CORS_ORIGINS=http://localhost:4200
# Producción: cambiar a la URL pública HTTPS; nunca incluir tokens de usuarios aquí.
AULASMART_SIGA_SYNC_CRON=0 */15 * * * *
